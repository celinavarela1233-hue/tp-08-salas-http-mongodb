<div class="panel-formulario">
<h1>Realizar una nueva reserva</h1>

<% if (locals.error) { %>
    <p role="alert" class="error"><%= error %></p>
<% } %>

<form class="formulario" action="/reservas" method="post" novalidate>

    <div>
        <label for="estudiante">Estudiante:</label>
        <input
            type="text"
            id="estudiante"
            name="estudiante"
            value="<%= valores?.estudiante || '' %>"
        >
    </div>

    <div>
        <label for="email">Email:</label>
        <input
            type="email"
            id="email"
            name="email"
            value="<%= valores?.email || '' %>"
        >
    </div>

    <div>
        <label for="sala">Sala:</label>
        <select id="sala" name="sala">
            <option value="">Seleccionar sala</option>
            <option value="Sala Norte" <%= valores?.sala === "Sala Norte" ? "selected" : "" %>>Sala Norte</option>
            <option value="Sala Sur" <%= valores?.sala === "Sala Sur" ? "selected" : "" %>>Sala Sur</option>
            <option value="Sala Multimedia" <%= valores?.sala === "Sala Multimedia" ? "selected" : "" %>>Sala Multimedia</option>
        </select>
    </div>

    <div>
        <label for="fecha">Fecha:</label>
        <input
            type="date"
            id="fecha"
            name="fecha"
            value="<%= valores?.fecha || '' %>"
        >
    </div>

    <div>
        <label for="turno">Turno:</label>
        <select id="turno" name="turno">
            <option value="">Seleccionar turno</option>
            <option value="Mañana" <%= valores?.turno === "Mañana" ? "selected" : "" %>>Mañana</option>
            <option value="Tarde" <%= valores?.turno === "Tarde" ? "selected" : "" %>>Tarde</option>
            <option value="Noche" <%= valores?.turno === "Noche" ? "selected" : "" %>>Noche</option>
        </select>
    </div>

    <div>
        <label for="personas">Cantidad de personas (1 a 6):</label>
        <input
            type="number"
            id="personas"
            name="personas"
            min="1"
            max="6"
            value="<%= valores?.personas || '' %>"
        >
    </div>

    <button type="submit">Confirmar reserva</button>

</form>
</div>